# HTCondor submit file for data preprocessing step
# Used in the DAGMan workflow example (Episode 08)

universe = docker
docker_image = python:3.10-slim

executable = run_preprocess.sh

transfer_input_files = ../scripts/preprocess_data.py, run_preprocess.sh, ../data/titanic_train.csv, ../data/titanic_test.csv
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

log    = logs/preprocess_$(Cluster).log
output = logs/preprocess_$(Cluster).out
error  = logs/preprocess_$(Cluster).err

request_cpus   = 1
request_memory = 2GB
request_disk   = 1GB

queue 1
