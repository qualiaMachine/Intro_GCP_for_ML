# HTCondor submit file for model evaluation step
# Used in the DAGMan workflow example (Episode 08)

universe = docker
docker_image = python:3.10-slim

executable = run_evaluate.sh

transfer_input_files = ../scripts/evaluate_model.py, run_evaluate.sh, requirements_xgboost.txt, titanic_test.csv, xgboost-model
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

log    = logs/evaluate_$(Cluster).log
output = logs/evaluate_$(Cluster).out
error  = logs/evaluate_$(Cluster).err

request_cpus   = 1
request_memory = 2GB
request_disk   = 1GB

queue 1
